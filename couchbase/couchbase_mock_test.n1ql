-- ============================================================================
-- 6. SMOKE-TEST QUERIES — satu per index/skenario, dengan ekspektasi hasil
-- ============================================================================

-- [R-02] Nasabah dengan >1 rekening aktif + total saldo
--   Ekspektasi: N001, jumlah_rekening=2, total_saldo=7500000
SELECT h.id_nasabah,
       COUNT(DISTINCT r.no_rekening) AS jumlah_rekening,
       SUM(r.saldo_efektif)          AS total_saldo
FROM `bri_tabungan`.`operasional`.`rekening` r
UNNEST r.pemegang_rekening h
WHERE r.status_rekening = 'AKTIF'
GROUP BY h.id_nasabah
HAVING COUNT(DISTINCT r.no_rekening) > 1
ORDER BY total_saldo DESC;

-- [R-04] Rekening tanpa transaksi > 90 hari (dari hari ini)
--   Ekspektasi: RKG002 (last_transaction_at 2026-06-01, > 90 hari dari 2026-11-16)
SELECT r.no_rekening, r.saldo_efektif, r.last_transaction_at
FROM `bri_tabungan`.`operasional`.`rekening` r
WHERE r.status_rekening = 'AKTIF'
  AND (r.last_transaction_at IS MISSING
       OR STR_TO_MILLIS(r.last_transaction_at) < STR_TO_MILLIS(NOW_STR()) - (90 * 86400000))
ORDER BY r.saldo_efektif DESC;

-- [R-05] Nasabah yang belum punya rekening
--   Ekspektasi: N003
SELECT n.id_nasabah, n.nama_lengkap
FROM `bri_tabungan`.`operasional`.`nasabah` n
WHERE ARRAY_LENGTH(n.rekening_refs) = 0 OR n.rekening_refs IS MISSING;

-- [R-06] Rekap jumlah rekening & total saldo per unit kerja
--   Ekspektasi: U001 -> 2 rekening, 7500000 ; U000 -> 1 rekening, 1000000
SELECT r.id_unit_kerja,
       COUNT(r.no_rekening)  AS jumlah_rekening,
       SUM(r.saldo_efektif)  AS total_saldo
FROM `bri_tabungan`.`operasional`.`rekening` r
WHERE r.status_rekening = 'AKTIF'
GROUP BY r.id_unit_kerja
ORDER BY total_saldo DESC;

-- [R-07] Riwayat posting bunga rekening RKG001, terbaru dulu
--   Ekspektasi: 2 baris, 202610 lalu 202609
SELECT p.periode, p.bunga_kotor, p.pajak_pph_final, p.bunga_bersih
FROM `bri_tabungan`.`operasional`.`posting_bunga` p
WHERE p.no_rekening = 'RKG001'
ORDER BY p.periode DESC;

-- [R-08] Instruksi terjadwal yang masih aktif
--   Ekspektasi: INS001
SELECT i.id_instruksi, i.jenis_instruksi, i.no_rekening_sumber, i.no_rekening_tujuan
FROM `bri_tabungan`.`operasional`.`instruksi_terjadwal` i
WHERE i.status_instruksi = 'AKTIF';

-- [R-09] Kartu debit kedaluwarsa dalam 30 hari ke depan
--   Ekspektasi: KTM001 (2026-12-05)
SELECT k.no_kartu, k.no_rekening, k.tanggal_kadaluarsa
FROM `bri_tabungan`.`operasional`.`kartu_debit` k
WHERE k.status_kartu = 'AKTIF'
  AND k.tanggal_kadaluarsa <= DATE_ADD_STR(NOW_STR(), 30, 'day');

-- [R-10] Distribusi jumlah & total saldo rekening per produk
--   Ekspektasi: P001 -> 2 rekening (RKG001,RKG003), P002 -> 1 rekening (RKG002)
SELECT r.id_produk,
       COUNT(r.no_rekening)  AS jumlah_rekening,
       SUM(r.saldo_efektif)  AS total_saldo
FROM `bri_tabungan`.`operasional`.`rekening` r
WHERE r.status_rekening = 'AKTIF'
GROUP BY r.id_produk
ORDER BY jumlah_rekening DESC;


-- ============================================================================
-- 7. (BONUS) Uji pola "guard document" untuk UNIQUE(nik)
--    Lihat catatan §4/§7 di couchbase_ddl.n1ql — N1QL tidak punya UNIQUE INDEX,
--    jadi keunikan nik ditegakkan lewat document KEY, bukan lewat GSI.
-- ============================================================================
-- Guard untuk nik milik N001 — sukses (key belum ada)
INSERT INTO `bri_tabungan`.`operasional`.`nasabah` (KEY, VALUE) VALUES
  ("nik::3201010101010001", {"id_nasabah": "N001"});

-- Coba daftar nasabah BARU dengan nik yang SAMA -> HARUS gagal (key sudah ada)
-- INSERT INTO `bri_tabungan`.`operasional`.`nasabah` (KEY, VALUE) VALUES
--   ("nik::3201010101010001", {"id_nasabah": "N999"});
-- Harapan: error "Duplicate Key" / LCB_KEY_EEXISTS — ini yang membuktikan
-- constraint UNIQUE(nik) tertegakkan secara atomic di level document key.
